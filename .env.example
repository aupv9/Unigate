# Template for local docker-compose secrets (NFR5 hardening).
#
# Copy this file to `.env` (gitignored, never commit real values) at
# the repo root. deploy/docker/docker-compose.yaml loads it into the
# unigate container's environment, and deploy/config/config.yaml
# expands these via ${VAR} / ${VAR:-default} at load time
# (internal/config/envexpand.go). Every var here has a dev-friendly
# fallback baked into config.yaml, so .env is optional for local dev -
# it only matters once you actually want different values than the
# checked-in defaults (e.g. anywhere real gateways connect).

# Redis AUTH password. Empty = unauthenticated Redis (fine for local
# dev with the bundled redis:7-alpine container).
UNIGATE_REDIS_PASSWORD=

# Per-gateway API keys the adapters must send as X-Unigate-Api-Key
# (see internal/api/authmw). Generate real random values before using
# this outside local dev - the "change-me-*" fallbacks baked into
# config.yaml must never reach a real deployment.
UNIGATE_KONG_API_KEY=change-me-kong
UNIGATE_APISIX_API_KEY=change-me-apisix
UNIGATE_APIGEE_API_KEY=change-me-apigee
